@baseUrl = https://api.example.com
@companyId = 1
@apiKey = YOUR_AUTHORIZED_TEST_API_KEY
@fromDate = 2026-10-01
@toDate = 2026-10-01
@promotionId = 10
@cashbackPromotionId = 12
@couponEventId = 20
@fromTimestamp = 2026-10-01T00:00:00
@toTimestamp = 2026-10-02T00:00:00
@itemsSince = REPLACE_WITH_ITEMS_BASELINE_OR_NEXT_SINCE
@itemsThrough = REPLACE_WITH_ITEMS_THROUGH
@itemsPolicyVersion = REPLACE_WITH_ITEMS_POLICY_VERSION
@itemsAfterItemId = REPLACE_WITH_ITEMS_NEXT_AFTER_ITEM_ID
@inventorySince = REPLACE_WITH_INVENTORY_BASELINE_OR_NEXT_SINCE
@inventoryThrough = REPLACE_WITH_INVENTORY_THROUGH
@inventoryPolicyVersion = REPLACE_WITH_INVENTORY_POLICY_VERSION
@inventoryAfterItemId = REPLACE_WITH_INVENTORY_NEXT_AFTER_ITEM_ID
@inventoryAfterStoreId = REPLACE_WITH_INVENTORY_NEXT_AFTER_STORE_ID

### Stores — stores.read
GET {{baseUrl}}/api/v1/companies/{{companyId}}/stores
X-IMS-API-Key: {{apiKey}}
Accept: application/json

### Suppliers — purchases.read
GET {{baseUrl}}/api/v1/companies/{{companyId}}/suppliers?page=1&pageSize=200
X-IMS-API-Key: {{apiKey}}
Accept: application/json

### Items — items.read
GET {{baseUrl}}/api/v1/companies/{{companyId}}/items?page=1&pageSize=200
X-IMS-API-Key: {{apiKey}}
Accept: application/json

### Inventory — inventory.read
GET {{baseUrl}}/api/v1/companies/{{companyId}}/inventory?page=1&pageSize=200
X-IMS-API-Key: {{apiKey}}
Accept: application/json

### Inventory Movements — inventory.read
GET {{baseUrl}}/api/v1/companies/{{companyId}}/inventory/movements?fromDate={{fromDate}}&toDate={{toDate}}&page=1&pageSize=200
X-IMS-API-Key: {{apiKey}}
Accept: application/json

### Sales — sales.read
