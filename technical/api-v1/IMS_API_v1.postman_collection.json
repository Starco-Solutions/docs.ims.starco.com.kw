    {
      "key": "toDate",
      "value": "2026-09-30"
    },
    {
      "key": "promotionId",
      "value": "1"
    },
    {
      "key": "couponEventId",
      "value": "1"
    },
    {
      "key": "since",
      "value": "REPLACE_WITH_CAPTURED_BASELINE_OR_LAST_NEXT_SINCE"
    },
    {
      "key": "policyVersion",
      "value": "REPLACE_WITH_SERVER_POLICY_VERSION"
    }
