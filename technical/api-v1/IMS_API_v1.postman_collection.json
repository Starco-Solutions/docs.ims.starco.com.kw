{
  "info": {
    "name": "IMS Business API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Read-only IMS API 1.1.0.0 examples using the /api/v1 route contract. Synthetic placeholders only. Replace collection variables with approved connection values before use."
